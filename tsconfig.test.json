{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "app/api/**/*.ts",
    "lib/**/*.ts"
  ]
}
